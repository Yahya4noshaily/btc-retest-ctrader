{
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' wss://demo.ctraderapi.com:5036 wss://live.ctraderapi.com:5036; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/scan.js": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "btc-monitor-v1",
          "retryAfterSeconds": 10
        }
      ]
    },
    "api/cloud.js": {
      "maxDuration": 60
    }
  }
}
